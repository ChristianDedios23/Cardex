PORT=3000
# Project URL only — do not append /rest/v1/
SUPABASE_URL=your-supabase-url
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Improves Pokémon TCG API rate limits and reliability — https://dev.pokemontcg.io
POKEMON_TCG_API_KEY=your_api_key_here
# Cache TTL for Pokémon TCG search/card responses in milliseconds (default: 30 minutes)
POKEMON_TCG_CACHE_TTL_MS=1800000