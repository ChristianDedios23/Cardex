{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",

        "module": "commonjs",
        "moduleResolution": "node",
        "target": "ES2022",
        "types": ["node"],

        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        "strict": true,
        "verbatimModuleSyntax": false,
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
